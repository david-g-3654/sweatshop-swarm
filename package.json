{
  "name": "sweatshop-swarm",
  "private": true,
  "version": "0.1.0",
  "description": "Watch a software team of AI agents ship a feature live.",
  "workspaces": [
    "packages/shared",
    "packages/orchestrator",
    "packages/web"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p packages/orchestrator",
    "rehearse": "npm --workspace @swarm/orchestrator run rehearse",
    "server": "npm --workspace @swarm/orchestrator run start",
    "test": "npm --workspace @swarm/orchestrator run test",
    "probe": "npm --workspace @swarm/orchestrator run probe",
    "swarm": "npm --workspace @swarm/orchestrator run swarm --"
  },
  "engines": {
    "node": ">=20"
  }
}
