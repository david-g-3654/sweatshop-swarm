{
  "name": "agent-arena",
  "private": true,
  "version": "0.1.0",
  "description": "Watch a software team of AI agents ship a feature live.",
  "workspaces": [
    "packages/shared",
    "packages/orchestrator",
    "packages/web"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p packages/orchestrator",
    "rehearse": "npm --workspace @arena/orchestrator run rehearse",
    "server": "npm --workspace @arena/orchestrator run start",
    "test": "npm --workspace @arena/orchestrator run test",
    "probe": "npm --workspace @arena/orchestrator run probe"
  },
  "engines": {
    "node": ">=20"
  }
}
