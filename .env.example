# ── Provider ────────────────────────────────────────────────────────────────
# Set ONE of these. The provider is auto-detected from whichever is present;
# set SWARM_PROVIDER explicitly only if you have both.

# OpenRouter (serves the Anthropic Messages API at /api — same agent loop)
OPENROUTER_API_KEY=sk-or-v1-...

# Or Anthropic directly
# ANTHROPIC_API_KEY=sk-ant-...

# SWARM_PROVIDER=openrouter        # openrouter | anthropic

# ── Models ──────────────────────────────────────────────────────────────────
# Defaults are opus-5 for the Planner, sonnet-5 for the workers, and get the
# "anthropic/" prefix automatically on OpenRouter.
#
# Cheapest sane setup for a tight budget — sonnet plans as well as it builds:
# SWARM_PLANNER_MODEL=anthropic/claude-sonnet-5
# SWARM_WORKER_MODEL=anthropic/claude-haiku-4.5

# ── Provider features ───────────────────────────────────────────────────────
# Run `npm run probe` and paste what it prints. It tests each of these against
# your key rather than guessing, because a rejected parameter is a 400 that
# kills the run instead of degrading it.
# SWARM_THINKING=1
# SWARM_EFFORT=1
# SWARM_STRICT_TOOLS=1
# SWARM_PROMPT_CACHE=1

# ── Effort per role ─────────────────────────────────────────────────────────
# low | medium | high | xhigh | max. Effort is the determinism knob here, since
# temperature is rejected outright on Sonnet 5 and Opus 5.
# Tune against live runs: lowering the engineers speeds the build up but also
# makes first drafts worse, and if they get *too* rough the Reviewer starts
# bouncing them for the wrong reasons.
# SWARM_EFFORT_PLANNER=high
# SWARM_EFFORT_ENGINEER=medium
# SWARM_EFFORT_REVIEWER=high
# SWARM_EFFORT_TESTER=low
# SWARM_EFFORT_DEPLOYER=low

# ── Limits and ports ────────────────────────────────────────────────────────
# SWARM_MAX_TURNS=14
# SWARM_MAX_REVIEW_ROUNDS=3
# SWARM_WS_PORT=8787
# SWARM_APP_PORT=4310
# SWARM_DEPLOY_TARGET=tunnel       # tunnel | local | fly
# SWARM_REHEARSAL_SPEED=2.5        # higher is slower; 1 finishes in ~9s
