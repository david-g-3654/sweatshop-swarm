# ── Provider ────────────────────────────────────────────────────────────────
# Set ONE of these. The provider is auto-detected from whichever is present;
# set ARENA_PROVIDER explicitly only if you have both.

# OpenRouter (serves the Anthropic Messages API at /api — same agent loop)
OPENROUTER_API_KEY=sk-or-v1-...

# Or Anthropic directly
# ANTHROPIC_API_KEY=sk-ant-...

# ARENA_PROVIDER=openrouter        # openrouter | anthropic

# ── Models ──────────────────────────────────────────────────────────────────
# Defaults are opus-5 for the Planner, sonnet-5 for the workers, and get the
# "anthropic/" prefix automatically on OpenRouter.
#
# Cheapest sane setup for a tight budget — sonnet plans as well as it builds:
# ARENA_PLANNER_MODEL=anthropic/claude-sonnet-5
# ARENA_WORKER_MODEL=anthropic/claude-haiku-4.5

# ── Provider features ───────────────────────────────────────────────────────
# Run `npm run probe` and paste what it prints. It tests each of these against
# your key rather than guessing, because a rejected parameter is a 400 that
# kills the run instead of degrading it.
# ARENA_THINKING=1
# ARENA_EFFORT=1
# ARENA_STRICT_TOOLS=1
# ARENA_PROMPT_CACHE=1

# ── Limits and ports ────────────────────────────────────────────────────────
# ARENA_MAX_TURNS=14
# ARENA_MAX_REVIEW_ROUNDS=3
# ARENA_WS_PORT=8787
# ARENA_APP_PORT=4310
# ARENA_DEPLOY_TARGET=tunnel       # tunnel | local | fly
# ARENA_REHEARSAL_SPEED=2.5        # higher is slower; 1 finishes in ~9s
