node_modules/
dist/
build/
.env
.env.local
*.log
.DS_Store

# agent sandbox: generated by runs, never committed
/sandbox/
/runs/*.json
!/runs/.gitkeep
# Recordings named sample-* are checked in so a fresh clone has something to
# replay immediately, and the booth loop's pruning leaves them alone. The
# filename has to stay equal to the runId inside it — that is how the loader
# finds it on disk.
!/runs/sample-*.json
